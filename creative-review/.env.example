# ── Access ───────────────────────────────────────────────────────────────
# Team password for the review UI (same idea as creative.vigomd.com's login).
REVIEW_PASSWORD=change-me
# Random 32+ char string used to sign the session cookie.
REVIEW_SESSION_SECRET=generate-a-long-random-string
# Bearer key the AI editor (Claude + scripts/review-cli.mjs) uses for the API.
REVIEW_API_KEY=generate-another-long-random-string

# ── Data store ───────────────────────────────────────────────────────────
# "json" = local file in .data/ (dev only). "airtable" = production.
REVIEW_STORE=json
# Airtable personal access token with data.records:read/write
# (+ schema.bases:read/write once, to create the tables from /review/setup).
AIRTABLE_TOKEN=
# Base that holds the Review tables. Vigo MD - Ads = appLGOqZqpYEgSKum
AIRTABLE_REVIEW_BASE_ID=appLGOqZqpYEgSKum

# ── File storage ─────────────────────────────────────────────────────────
# "local" = .data/files (dev only). "blob" = Vercel Blob (production).
REVIEW_FILES=local
# Set automatically when you connect a Blob store to the Vercel project.
BLOB_READ_WRITE_TOKEN=

# ── Notifications (optional) ─────────────────────────────────────────────
# Any URL that accepts a JSON POST (Make scenario, Slack workflow, Telegram relay).
REVIEW_WEBHOOK_URL=
# Public base URL used in notification links, e.g. https://creative.vigomd.com
REVIEW_PUBLIC_URL=
